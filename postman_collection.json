            },
            "url": {
              "raw": "{{baseUrl}}/prescriptions/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["prescriptions", ":id", "status"],
              "variable": [
                {
                  "key": "id",
                  "value": "PRESCRIPTION_ID"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
