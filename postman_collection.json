{
  "info": {
    "name": "Apotik Backend API",
    "description": "Collection untuk testing API Sistem Manajemen Apotik",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Apotik\",\n  \"email\": \"admin@apotik.com\",\n  \"password\": \"admin123\",\n  \"role\": \"admin_apotik\",\n  \"phoneNumber\": \"081234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Register Dokter",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Budi\",\n  \"email\": \"dokter@apotik.com\",\n  \"password\": \"dokter123\",\n  \"role\": \"dokter\",\n  \"phoneNumber\": \"081234567891\",\n  \"specialization\": \"Dokter Umum\",\n  \"licenseNumber\": \"SIP123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@apotik.com\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["patients"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"dateOfBirth\": \"1985-05-15\",\n  \"gender\": \"Laki-laki\",\n  \"address\": \"Jl. Merdeka No. 10\",\n  \"phoneNumber\": \"081234567892\",\n  \"allergies\": [\"Penisilin\"],\n  \"bloodType\": \"A+\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["patients"]
            }
          }
        }
      ]
    },
    {
      "name": "Medicines",
      "item": [
        {
          "name": "Get All Medicines",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/medicines",
              "host": ["{{baseUrl}}"],
              "path": ["medicines"]
            }
          }
        },
        {
          "name": "Create Medicine",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"MED001\",\n  \"name\": \"Paracetamol 500mg\",\n  \"genericName\": \"Paracetamol\",\n  \"category\": \"Tablet\",\n  \"manufacturer\": \"Kimia Farma\",\n  \"dosage\": \"500mg\",\n  \"unit\": \"Tablet\",\n  \"stock\": 100,\n  \"minStock\": 20,\n  \"price\": 5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/medicines",
              "host": ["{{baseUrl}}"],
              "path": ["medicines"]
            }
          }
        },
        {
          "name": "Update Stock - Add",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 50,\n  \"operation\": \"add\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/medicines/:id/stock",
              "host": ["{{baseUrl}}"],
              "path": ["medicines", ":id", "stock"],
              "variable": [
                {
                  "key": "id",
                  "value": "MEDICINE_ID"
                }
              ]
            }
          }
        },
        {
          "name": "Get Low Stock Medicines",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/medicines/alerts/low-stock",
              "host": ["{{baseUrl}}"],
              "path": ["medicines", "alerts", "low-stock"]
            }
          }
        }
      ]
    },
