# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=apotik_db
DB_CONNECTION_LIMIT=10

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Legacy Integration (Opsional - Migrasi Data Lama)
# Isi jika ingin tarik data dari database legacy
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=

# Nama tabel legacy master obat
LEGACY_MEDICINES_TABLE=

# Mapping kolom legacy -> domain medicines (ubah sesuai struktur tabel lama)
LEGACY_MED_COL_ID=id
LEGACY_MED_COL_CODE=kode_obat
LEGACY_MED_COL_NAME=nama_obat
LEGACY_MED_COL_GENERIC_NAME=nama_generik
LEGACY_MED_COL_CATEGORY=kategori
LEGACY_MED_COL_UNIT=satuan
LEGACY_MED_COL_STOCK=jumlah_aktual
LEGACY_MED_COL_MIN_STOCK=stok_minimum
LEGACY_MED_COL_PRICE=harga_jual
LEGACY_MED_COL_EXPIRY_DATE=exp_date
LEGACY_MED_COL_BATCH_NUMBER=batch_number
LEGACY_MED_COL_MANUFACTURER=pabrik
LEGACY_MED_COL_DESCRIPTION=keterangan
LEGACY_MED_COL_IS_ACTIVE=aktif
